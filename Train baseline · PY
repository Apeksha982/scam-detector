# train_baseline.py
#detect fake job postings with TF-IDF + Logistic Regression.

import pandas as pd
import joblib
from sklearn.model_selection import train_test_split
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.linear_model import LogisticRegression
from sklearn.pipeline import Pipeline
from sklearn.metrics import classification_report, confusion_matrix

# 1. Load data
df = pd.read_csv("fake_job_postings.csv")
print("Rows:", len(df))
print("Fake share:", round(df["fraudulent"].mean(), 3))  # classes are very imbalanced

# 2. Combine the text columns into one field
text_cols = ["title", "company_profile", "description", "requirements", "benefits"]
df["text"] = df[text_cols].fillna("").agg(" ".join, axis=1)

# 3. Stratified split keeps the same fake/real ratio in train and test
X_train, X_test, y_train, y_test = train_test_split(
    df["text"], df["fraudulent"],
    test_size=0.2, random_state=42, stratify=df["fraudulent"],
)

# 4. Model: class_weight="balanced" handles the imbalance
pipe = Pipeline([
    ("tfidf", TfidfVectorizer(max_features=50000, ngram_range=(1, 2),
                              stop_words="english", sublinear_tf=True)),
    ("clf", LogisticRegression(class_weight="balanced", max_iter=1000)),
])
pipe.fit(X_train, y_train)

# 5. Evaluate. Look at precision/recall of class 1 (fake), NOT accuracy.
pred = pipe.predict(X_test)
print(classification_report(y_test, pred, target_names=["real", "fake"]))
print("Confusion matrix:\n", confusion_matrix(y_test, pred))

# 6. Which words push a posting toward "fake"? (useful for explanations)
vec = pipe.named_steps["tfidf"]
clf = pipe.named_steps["clf"]
names = vec.get_feature_names_out()
top = clf.coef_[0].argsort()[-20:][::-1]
print("Top scam-signal terms:", [names[i] for i in top])

# 7. Save the model for the app
joblib.dump(pipe, "scam_model.joblib")
print("Saved scam_model.joblib")
